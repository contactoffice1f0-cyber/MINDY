{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: bootRun",
      "type": "shell",
      "command": ".\\gradlew.bat bootRun",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "backend: test",
      "type": "shell",
      "command": ".\\gradlew.bat test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "frontend: start",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": { "BROWSER": "none" }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "MINDY: run all",
      "dependsOn": ["backend: bootRun", "frontend: start"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
